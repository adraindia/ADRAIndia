rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isADRAUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('.*@adraindia\\.org');
    }

    // Check isAdmin via the users collection record (set at login time)
    // This works for both Google and Microsoft providers regardless of token format
    function isAdmin() {
      return isADRAUser()
        && (
          request.auth.token.email.lower() == 'trisha.mahajan@adraindia.org'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
    }

    match /submissions/{submissionId} {
      allow create: if isADRAUser() && request.resource.data.userId == request.auth.uid;
      allow read:   if isADRAUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isADRAUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    function isMainAdmin() {
      return isADRAUser()
        && request.auth.token.email.lower() == 'trisha.mahajan@adraindia.org';
    }

    function changesAdminFlag() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']);
    }

    match /users/{userId} {
      allow read:   if isADRAUser();
      // Users keep their own profile but cannot make themselves admin
      allow create: if isADRAUser() && request.auth.uid == userId
        && (request.resource.data.get('isAdmin', false) == false || isMainAdmin());
      allow update: if isADRAUser() && (
        (request.auth.uid == userId && (!changesAdminFlag() || isMainAdmin()))
        // Admins can grant or revoke admin for others, and change nothing else
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAdmin']))
      );
    }

    match /projects/{projectId} {
      allow read:  if isADRAUser();
      allow write: if isAdmin();
    }
  }
}
