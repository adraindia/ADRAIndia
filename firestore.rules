rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isADRAUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('.*@adraindia\\.org');
    }

    function isAdmin() {
      return isADRAUser()
        && request.auth.token.email.lower() == 'trisha.mahajan@adraindia.org';
    }

    // Submissions — users own their own, admin can read/update all
    match /submissions/{submissionId} {
      allow create: if isADRAUser() && request.resource.data.userId == request.auth.uid;
      allow read:   if isADRAUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isADRAUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Users — any ADRA user can write their own record, any can read
    match /users/{userId} {
      allow read:  if isADRAUser();
      allow write: if isADRAUser() && request.auth.uid == userId;
    }

    // Projects — any ADRA user can read (needed for dropdown), only admin can write
    match /projects/{projectId} {
      allow read:  if isADRAUser();
      allow write: if isAdmin();
    }
  }
}
