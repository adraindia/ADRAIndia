rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from a signed-in @adraindia.org user?
    function isADRAUser() {
      return request.auth != null
        && request.auth.token.email.matches('.*@adraindia\\.org');
    }

    // Helper: is the user the admin?
    function isAdmin() {
      return isADRAUser()
        && request.auth.token.email.lower() == 'trisha.mahajan@adraindia.org';
    }

    // Submissions
    match /submissions/{submissionId} {
      // Any ADRA user can create
      allow create: if isADRAUser()
        && request.resource.data.userId == request.auth.uid;

      // Owner can read & update their own; admin can read & update all
      allow read:   if isADRAUser()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isADRAUser()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // Only admin can delete
      allow delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      // Any ADRA user can write their own record (created on first login)
      allow write: if isADRAUser() && request.auth.uid == userId;

      // Any ADRA user can read user records (for admin views)
      allow read:  if isADRAUser();
    }
  }
}
